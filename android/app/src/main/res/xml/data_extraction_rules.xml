<?xml version="1.0" encoding="utf-8"?>
<!-- Aturan ekstraksi data Android 12+ untuk Go Green.
     Backup dimatikan karena aplikasi menyimpan token sesi dan preferensi lokal;
     data tersebut tidak boleh ikut ter-salin ke cloud backup atau perpindahan device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>