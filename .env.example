# Konfigurasi aplikasi Go Green.
#
# PENTING: file .env SENGAJA tidak lagi dibundel ke APK/IPA (tidak ada di
# bagian assets pubspec.yaml) supaya credential tidak ikut tersebar ke device
# pengguna. App membaca konfigurasi lewat --dart-define lebih dulu, dengan
# .env sebagai fallback lokal saja.
#
# Cara menjalankan lokal:
#   flutter run --dart-define=SUPABASE_URL=<url> --dart-define=SUPABASE_ANON_KEY=<key>
#
# src/ENVIRONMENT_SETUP.md punya contoh lengkap per mode.

# Supabase (wajib)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI Forensics (opsional, fase lanjut)
# HIVE_API_KEY=
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=

# Mode datasource: supabase (production), dummy (json-server), laravel (backend alternatif)
DATA_SOURCE=supabase
LARAVEL_API_URL=http://127.0.0.1:8000/api

# Mode dummy json-server (testing tanpa Supabase, dipakai bila DATA_SOURCE kosong)
USE_DUMMY_API=true
DUMMY_API_URL=http://localhost:3001

# Catatan: JANGAN menaruh API key pihak ketiga yang tidak perlu ada di sisi
# client (mis. kunci AI/Stitch/analitik) di file ini. Nilai seperti itu akan
# terekspos ke device mana pun yang memakai aplikasi.