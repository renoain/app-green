# Supabase
# Salin file ini menjadi .env lalu isi. Sudah login di supabase_service.dart
# otomatis dari .env atau --dart-define. Jangan commit .env.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# # AI Forensics (opsional, fase lanjut)
# HIVE_API_KEY=
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=

# Mode datasource: supabase (production), dummy (json-server), laravel (backend alternatif)
DATA_SOURCE=supabase
LARAVEL_API_URL=http://127.0.0.1:8000/api

# Mode dummy json-server (testing tanpa Supabase, dipakai bila DATA_SOURCE kosong)
USE_DUMMY_API=true
DUMMY_API_URL=http://localhost:3001